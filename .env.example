# ==============================================================================
# MAYILON CRACKERS - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for development, or set these in your Vercel Project Settings.
# ==============================================================================

# 1. Supabase Cloud Database Configuration (Recommended for Production Persistence)
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional direct PostgreSQL connection string (Supabase -> Database -> Connection string)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
# POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# 2. Admin Authentication
ADMIN_PASSCODE=mayilon-admin

# 3. SMS Gateway Credentials for Customer OTP
FAST2SMS_API_KEY=your_fast2sms_api_key
TWO_FACTOR_API_KEY=your_2factor_api_key

# 4. Public Site URL
NEXT_PUBLIC_SITE_URL=https://www.mayiloncrackers.com
